{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "konigslibrary",
  "version": "0.6.0",
  "identifier": "com.konigslibrary.reader",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "TAURI_BUILD=1 bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "konigslibrary",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https:; connect-src 'self' http: https:; img-src 'self' asset: http: https: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "$APPDATA/offline/**"
          ]
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "konigslibrary"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "konigslibrary"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "GraphicsAndDesign",
    "homepage": "https://github.com/NasreddinHodja/konigslibrary",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/konigslibrary-server-assets": "binaries/konigslibrary-server-assets"
    },
    "linux": {
      "appimage": {
        "files": {
          "usr/share/metainfo/com.konigslibrary.reader.metainfo.xml": "com.konigslibrary.reader.metainfo.xml"
        }
      }
    }
  }
}
