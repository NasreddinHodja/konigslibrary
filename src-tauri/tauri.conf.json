{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "konigslibrary",
  "version": "0.11.2",
  "identifier": "nasreddinhodja.konigslibrary",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "konigslibrary",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https:; script-src 'self'; connect-src 'self' ipc: blob: http: https:; img-src 'self' asset: http: https: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "$APPDATA/offline/**",
            "$APPDATA/library/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "GraphicsAndDesign",
    "homepage": "https://github.com/NasreddinHodja/konigslibrary",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/konigslibrary-server-assets": "binaries/konigslibrary-server-assets"
    },
    "linux": {
      "appimage": {
        "files": {
          "usr/share/metainfo/nasreddinhodja.konigslibrary.metainfo.xml": "nasreddinhodja.konigslibrary.metainfo.xml"
        }
      }
    }
  }
}
