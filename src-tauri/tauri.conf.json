{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "konigslibrary",
  "version": "0.4.0",
  "identifier": "com.konigslibrary.reader",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "TAURI_BUILD=1 bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "konigslibrary",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https:; img-src 'self' asset: https: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["$HOME/**", "$APPDATA/**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
