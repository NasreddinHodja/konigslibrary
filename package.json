{
  "name": "konigslibrary",
  "description": "Client-side manga reader built with Svelte 5 + SvelteKit",
  "packageManager": "bun@1.2.0",
  "version": "0.9.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NasreddinHodja/konigslibrary.git"
  },
  "homepage": "https://github.com/NasreddinHodja/konigslibrary",
  "scripts": {
    "dev": "bun run build:wasm && vite dev",
    "build": "bun run build:wasm && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "bun run build:wasm && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "bun run build:wasm && vitest run",
    "test:coverage": "bun run build:wasm && vitest run --coverage",
    "build:wasm": "bun scripts/build-wasm.js",
    "clean:kit": "rm -rf .svelte-kit",
    "build:server": "cargo build --manifest-path crates/Cargo.toml -p klserver --release",
    "test:rust": "cargo test --manifest-path crates/Cargo.toml",
    "coverage:rust": "cargo llvm-cov --manifest-path crates/Cargo.toml --workspace --html --output-dir coverage/rust",
    "serve": "bun run build:local && bun run build:server && crates/target/release/konigslibrary-server",
    "dev:local": "bun run build:wasm && bun scripts/dev-local.js",
    "dev:host": "bun run build:wasm && bun scripts/dev-local.js --host",
    "dev:sim": "bun scripts/gen-dev-library.js --if-missing && MANGA_DIR=dev-library bun run dev:local",
    "gen:dev-library": "bun scripts/gen-dev-library.js",
    "build:local": "bun run clean:kit && bun run prepare && LOCAL_BUILD=1 bun run build",
    "tauri:local": "LOCAL_BUILD=1 bun tauri dev",
    "dev:android": "bun tauri android dev",
    "build:android": "bun run clean:kit && bun run prepare && bun tauri android build --target aarch64 && APK=$(ls -t src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release*.apk | head -1) && mkdir -p dist && cp \"$APK\" dist/konigslibrary_$(bun -p \"require('./package.json').version\")_arm64.apk",
    "build:sidecar": "bun scripts/build-sidecar.js",
    "build:desktop": "bun scripts/build-appimage.js",
    "build:desktop:host": "bun run build:sidecar && bun run clean:kit && bun run prepare && bun tauri build",
    "build:windows": "bun scripts/build-windows.js",
    "build:tauri": "TAURI_BUILD=1 bun run build",
    "version": "bun scripts/sync-version.js"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.4",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@sveltejs/mcp": "^0.1.26",
    "@tanstack/svelte-virtual": "^3.13.39",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "embla-carousel": "^8.6.0",
    "lucide-svelte": "^1.0.1",
    "qrcode-generator": "^2.0.4"
  }
}
