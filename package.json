{
  "name": "konigslibrary",
  "description": "Client-side manga reader built with Svelte 5 + SvelteKit",
  "packageManager": "bun@1.2.0",
  "version": "0.7.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NasreddinHodja/konigslibrary.git"
  },
  "homepage": "https://github.com/NasreddinHodja/konigslibrary",
  "scripts": {
    "dev": "bun run build:wasm && vite dev",
    "build": "bun run build:wasm && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "bun run build:wasm && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "bun run build:wasm && vitest run",
    "build:wasm": "bun scripts/build-wasm.js",
    "clean:kit": "rm -rf .svelte-kit",
    "build:server": "cargo build --manifest-path crates/Cargo.toml -p klserver --release",
    "test:rust": "cargo test --manifest-path crates/Cargo.toml",
    "serve": "bun run build:local && bun run build:server && crates/target/release/konigslibrary-server",
    "dev:local": "bun run build:wasm && bun scripts/dev-local.js",
    "dev:host": "bun run build:wasm && bun scripts/dev-local.js --host",
    "build:local": "bun run clean:kit && bun run prepare && LOCAL_BUILD=1 bun run build",
    "tauri:local": "LOCAL_BUILD=1 bun tauri dev",
    "dev:android": "bun tauri android dev",
    "build:android": "bun run clean:kit && bun run prepare && bun tauri android build --target aarch64 && ~/.local/src/Android/build-tools/36.1.0/apksigner sign --ks src-tauri/konigslibrary.jks --ks-key-alias konigslibrary --out konigslibrary.apk src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release-unsigned.apk",
    "build:sidecar": "bun scripts/build-sidecar.js",
    "build:desktop": "bun scripts/build-appimage.js",
    "build:desktop:host": "bun run build:sidecar && bun run clean:kit && bun run prepare && bun tauri build",
    "build:windows": "bun scripts/build-windows.js",
    "build:tauri": "TAURI_BUILD=1 bun run build",
    "version": "bun scripts/sync-version.js"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.4",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.67.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@sveltejs/mcp": "^0.1.24",
    "@tanstack/svelte-virtual": "^3.13.29",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "lucide-svelte": "^0.563.0",
    "qrcode-generator": "^2.0.4"
  }
}
