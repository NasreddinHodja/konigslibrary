# Checks for a new release once a day. konigslibrary-update enables it the
# first time it installs it; `systemctl disable --now konigslibrary-update.timer`
# turns it off, and later updates leave it off.
[Unit]
Description=Update konigslibrary daily

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
