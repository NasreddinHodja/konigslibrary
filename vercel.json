{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "rustup target add wasm32-unknown-unknown && cargo install -f wasm-bindgen-cli --version 0.2.99 && bun install --frozen-lockfile",
  "buildCommand": "STATIC_BUILD=1 bun run build",
  "outputDirectory": "build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
